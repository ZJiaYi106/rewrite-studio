# Required for LLM rewriting. Any OpenAI-compatible endpoint is supported.
OPENAI_API_KEY=
OPENAI_BASE_URL=
REWRITE_MODEL=gpt-4o-mini
REWRITE_TEMPERATURE=0.85
REWRITE_MAX_TOKENS=6000
# Generous limits for slow providers and long articles (seconds).
REQUEST_TIMEOUT_SECONDS=300
IMAGE_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=2

# AI image regeneration: base URLs end with /v1, NOT /images/generations.
# Fill the exact model IDs supplied by your provider. Empty keys inherit OPENAI_API_KEY.
VLM_MODEL=
VLM_API_KEY=
VLM_BASE_URL=
VLM_TIMEOUT_SECONDS=600
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_TIMEOUT_SECONDS=600
IMAGE_GEN_SIZE=1024x1024
# Number of thematic images to generate per article: 3-5, default 5.
IMAGE_REGENERATE_COUNT=5

# Image strategy: skip | light_edit | regenerate
IMAGE_STRATEGY=skip
BASE_OUTPUT_DIR=./output
TEMP_DIR=./temp

# Web server defaults
WEB_HOST=127.0.0.1
WEB_PORT=8000
# One job may run for up to one hour before the safety ceiling applies.
WEB_JOB_TIMEOUT_SECONDS=3600
